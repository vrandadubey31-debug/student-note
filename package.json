{
  "name": "student-notes-manager",
  "version": "1.0.0",
  "description": "Student Notes Manager - Full Stack",
  "private": true,
  "scripts": {
    "start:backend": "cd backend\\server && node server.js",
    "start:frontend": "cd frontend\\client && npm start",
    "install:backend": "cd backend\\server && npm install",
    "install:frontend": "cd frontend\\client && npm install",
    "install:all": "npm run install:backend && npm run install:frontend"
  }
}
